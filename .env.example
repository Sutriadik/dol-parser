# Open ADE — contoh konfigurasi. Salin jadi `.env`, lalu isi nilainya.
#
#     cp .env.example .env
#
# `.env` ada di .gitignore dan TIDAK boleh di-commit: repo ini publik di GitHub.
# Berkas ini (`.env.example`) aman di-commit karena tidak memuat satu pun nilai asli.

# --- Keamanan API -----------------------------------------------------------------
# Kunci yang harus dikirim n8n di header `X-API-Key`. Kosong = API terbuka tanpa
# autentikasi; itu hanya aman selama service cuma dijangkau dari localhost.
# WAJIB diisi begitu service dipasang di server. Membuat nilainya:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENADE_API_KEY=

# Origin browser yang boleh memanggil API (dashboard/web client), dipisah koma.
# n8n memanggil dari sisi server tanpa header Origin, jadi tidak terpengaruh nilai ini.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Batas ukuran unggahan (MB) dan timeout saat mem-POST hasil ke callback_url n8n (detik).
MAX_UPLOAD_MB=50
CALLBACK_TIMEOUT=30

# --- NocoDB -----------------------------------------------------------------------
NOCODB_URL=http://localhost:8080
# NocoDB > foto profil > Account Settings > Tokens > Add New Token
NOCODB_API_TOKEN=
# Bagian /base/<id> pada URL NocoDB saat base terbuka.
NOCODB_BASE_ID=
# NocoDB v2 memakai tableId acak, bukan nama tabel, jadi pemetaan harus eksplisit.
# Kunci = nama teknis tabel dol-schema. Dicetak oleh: python scripts/nocodb_setup.py --create-base
#   NOCODB_TABLE_IDS="document:m1abc,contract:m2def,extracted_field:m3ghi,field_review:m4jkl"
NOCODB_TABLE_IDS=
# Push langsung FastAPI -> NocoDB. Biarkan 0: pada arsitektur briefing (hlm. 8) n8n yang
# mengorkestrasi push. Nyalakan hanya untuk uji coba atau deployment tanpa n8n.
NOCODB_PUSH_ENABLED=0

# --- Ollama / LLM -----------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Default server Ollama (4096) memotong prompt kontrak (~8k token) tanpa pesan apa pun.
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

# --- Parser / OCR -----------------------------------------------------------------
# rapidocr | mac | tesseract | paddle | auto
# Default rapidocr, bukan mac: Apple Vision hanya ada di macOS, jadi angka akurasi yang
# diukur dengannya tidak bisa ditepati server Linux/Windows.
OCR_ENGINE=rapidocr
LOG_LEVEL=INFO
